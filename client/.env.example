# Next.js storefront runs on http://localhost:3000 by default.
# NestJS API runs on http://localhost:5000/api/v1.
NEXT_PUBLIC_BASE_URL=http://localhost:5000/api/v1

# Cloudflare Turnstile public site key (safe to expose in the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google OAuth Web Client ID (public identifier; never put client secrets here).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook Login App ID (public identifier; never put app secrets here).
NEXT_PUBLIC_FACEBOOK_APP_ID=
