# Backend runtime configuration
PORT=3000
ADMIN_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Redis / BullMQ. Keep Redis private; require authentication/TLS in production.
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL — use a local/test database for development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# Stripe Hosted Checkout (use Stripe test-mode keys locally).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Apliiq is deliberately MOCK by default. Mock mode makes no outbound requests
# and does not require live credentials. Change to "live" only after verification.
APLIIQ_MODE=mock
APLIIQ_API_BASE_URL=https://api.apliiq.com
APLIIQ_APP_ID=
APLIIQ_SHARED_SECRET=
APLIIQ_FULFILLMENT_WEBHOOK_TOKEN=
