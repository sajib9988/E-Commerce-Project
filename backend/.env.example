# Backend runtime configuration
# Use development locally; set production explicitly on the deployed server.
NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
# Set to the number of trusted reverse-proxy hops only when the origin is protected by that proxy.
TRUST_PROXY=1
ADMIN_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Redis / BullMQ. Keep Redis private; require authentication/TLS in production.
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL — use a local/test database for development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# Cloudflare Turnstile (required in production for registration/password-reset protection).
TURNSTILE_SECRET_KEY=

# OAuth provider application credentials (server-side only).
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email notifications (configure either Gmail OAuth2 or SMTP).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
GMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe Hosted Checkout (use Stripe test-mode keys locally).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Apliiq is deliberately MOCK by default. Mock mode makes no outbound requests
# and does not require live credentials. Change to "live" only after verification.
APLIIQ_MODE=mock
APLIIQ_API_BASE_URL=https://api.apliiq.com
APLIIQ_APP_ID=
APLIIQ_SHARED_SECRET=
APLIIQ_FULFILLMENT_WEBHOOK_TOKEN=
