model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  products      Product[]
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Subcategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products    Product[]
  sizeTemplateId String?
  sizeTemplate SizeTemplate? @relation(fields: [sizeTemplateId], references: [id], onDelete: SetNull)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId, isActive, sortOrder])
  @@map("subcategories")
}

model Product {
  id             String        @id @default(cuid())
  name           String
  description    String?
  regularPrice   Decimal       @db.Decimal(10, 2)
  salePrice      Decimal?      @db.Decimal(10, 2)
  brand          String?
  sizes          String[]      @default([])
  sku            String?       @unique
  apliiqDesignSku String?
  stockQuantity  Int           @default(0)
  isActive       Boolean       @default(true)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId  String
  subcategory    Subcategory   @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  imageUrl       String
  imagePublicId  String?
  artworks       ProductArtwork[]
  apliiqDesigns   ApliiqProductDesign[]
  orderItems     OrderItem[]
  reservationItems StockReservationItem[]
  variants       ProductVariant[]
  reviews        ProductReview[]
  collections    ProductCollection[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive, createdAt])
  @@map("products")
}


model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  bannerImage String?
  thumbnail   String?
  isActive    Boolean             @default(true)
  isFeatured  Boolean             @default(false)
  sortOrder   Int                 @default(0)
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([isActive, isFeatured, sortOrder])
  @@map("collections")
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@id([productId, collectionId])
  @@index([collectionId, sortOrder])
  @@map("product_collections")
}

model SizeTemplate {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String?
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  subcategories Subcategory[]
  sizes         ProductSize[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isActive, sortOrder])
  @@map("size_templates")
}

model ProductSize {
  id             String            @id @default(cuid())
  templateId     String
  template       SizeTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  label          String
  normalizedKey  String
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  variants       ProductVariant[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([templateId, normalizedKey])
  @@index([templateId, isActive, sortOrder])
  @@map("product_sizes")
}

model ProductVariant {
  id               String                 @id @default(cuid())
  productId        String
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  sizeId           String
  size             ProductSize            @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  sku              String                 @unique
  regularPrice     Decimal                @db.Decimal(10, 2)
  salePrice        Decimal?               @db.Decimal(10, 2)
  stockQuantity    Int                    @default(0)
  apliiqVariantSku String?
  apliiqDesignId   String?
  colorName        String?
  colorHex         String?
  apliiqColorId    String?
  isActive         Boolean                @default(true)
  orderItems       OrderItem[]
  reservationItems StockReservationItem[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([productId, sizeId, apliiqColorId])
  @@index([productId, isActive])
  @@index([productId, apliiqColorId])
  @@index([sizeId, isActive])
  @@map("product_variants")
}

model Order {
  id               String             @id @default(cuid())
  orderNumber      String             @unique @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus      @default(PENDING)
  currency         String             @default("usd")
  subtotalAmount   Decimal            @db.Decimal(10, 2)
  discountAmount   Decimal            @default(0) @db.Decimal(10, 2)
  shippingAmount   Decimal            @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal            @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal            @db.Decimal(10, 2)
  shippingAddress  Json
  billingAddress   Json?
  customerEmail    String
  customerName     String?
  customerPhone    String?
  couponCode       String?
  idempotencyKey   String             @unique
  paidAt           DateTime?
  items            OrderItem[]
  paymentAttempts  PaymentAttempt[]
  stockReservation StockReservation?
  couponRedemption CouponRedemption?
  fulfillments     Fulfillment[]
  reviews          ProductReview[]
  refundRequests   RefundRequest[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([status, paymentStatus])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku            String?
  apliiqDesignSku String?
  unitPrice      Decimal  @db.Decimal(10, 2)
  quantity       Int
  lineTotal      Decimal  @db.Decimal(10, 2)
  imageUrl       String?
  variantSnapshot Json?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model PaymentAttempt {
  id                       String               @id @default(cuid())
  orderId                  String
  order                    Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                 String               @default("STRIPE")
  status                   PaymentAttemptStatus @default(CREATED)
  amount                   Decimal              @db.Decimal(10, 2)
  currency                 String
  stripeCheckoutSessionId  String?              @unique
  checkoutExpiresAt        DateTime?
  stripePaymentIntentId    String?              @unique
  paidAt                   DateTime?
  requiresManualReview     Boolean              @default(false)
  reviewReason             String?
  reviewResolvedAt         DateTime?
  reviewResolvedBy         String?
  reviewResolution         String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([orderId, status])
  @@map("payment_attempts")
}

model StockReservation {
  id          String                 @id @default(cuid())
  orderId     String                 @unique
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      StockReservationStatus @default(RESERVED)
  expiresAt   DateTime
  committedAt DateTime?
  releasedAt  DateTime?
  items       StockReservationItem[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status, expiresAt])
  @@map("stock_reservations")
}

model StockReservationItem {
  id            String           @id @default(cuid())
  reservationId String
  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId     String?
  variant       ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity      Int
  createdAt     DateTime         @default(now())

  @@unique([reservationId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("stock_reservation_items")
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  type              CouponType
  value             Decimal            @db.Decimal(10, 2)
  minOrderAmount    Decimal?           @db.Decimal(10, 2)
  maxDiscountAmount Decimal?           @db.Decimal(10, 2)
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean            @default(true)
  usageLimit        Int?
  usageCount        Int                @default(0)
  perUserLimit      Int                @default(1)
  userId            String?
  user              User?              @relation("AssignedCoupons", fields: [userId], references: [id], onDelete: SetNull)
  redemptions       CouponRedemption[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([isActive, startsAt, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String                 @id @default(cuid())
  couponId       String
  coupon         Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId        String                 @unique
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  discountAmount Decimal                @db.Decimal(10, 2)
  status         CouponRedemptionStatus @default(RESERVED)
  redeemedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([couponId, userId, status])
  @@map("coupon_redemptions")
}

model StripeWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@map("stripe_webhook_events")
}

model Fulfillment {
  id                String                    @id @default(cuid())
  orderId           String
  order             Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String                    @default("APLIIQ")
  submissionStatus  FulfillmentSubmissionStatus @default(SUBMITTING)
  externalOrderId   String?                   @unique
  providerStatus    String?
  trackingCompany   String?
  trackingNumbers   String[]                  @default([])
  trackingUrls      String[]                  @default([])
  submittedAt       DateTime?
  shippedAt         DateTime?
  lastErrorCode     String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([orderId, provider])
  @@index([submissionStatus, updatedAt])
  @@map("fulfillments")
}


model ProductReview {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rating      Int
  title       String?
  body        String
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?
  moderatedBy String?
  moderationNote String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@map("product_reviews")
}

model RefundRequest {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          RefundRequestStatus @default(PENDING)
  reason          String
  customerNote    String?
  adminNote       String?
  amount          Decimal             @db.Decimal(10, 2)
  stripeRefundId  String?             @unique
  reviewedBy      String?
  reviewedAt      DateTime?
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("refund_requests")
}


model ProductArtwork {
  id                String                     @id @default(cuid())
  productId         String
  product           Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  imageUrl          String
  imagePublicId     String?
  apliiqArtworkId   String?                    @unique
  isPrimary         Boolean                    @default(false)
  placements        ProductArtworkPlacement[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([productId, isPrimary])
  @@map("product_artworks")
}

model ProductArtworkPlacement {
  id          String         @id @default(cuid())
  artworkId   String
  artwork     ProductArtwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  locationId  String
  service     String
  printColors String?
  boxId       Int?
  note        String?
  widthInches Decimal?       @db.Decimal(6, 2)
  heightInches Decimal?      @db.Decimal(6, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([artworkId])
  @@map("product_artwork_placements")
}

model ApliiqProductDesign {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId         String
  productCode     String
  apliiqDesignId  String
  mockupUrl       String?
  mockupUrls      String[] @default([])
  providerPayload Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, colorId])
  @@index([apliiqDesignId])
  @@map("apliiq_product_designs")
}
