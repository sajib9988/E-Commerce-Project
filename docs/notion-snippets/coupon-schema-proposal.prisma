enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum CouponRedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  type              CouponType
  value             Decimal            @db.Decimal(12, 2)
  minOrderAmount    Decimal?           @db.Decimal(12, 2)
  maxDiscountAmount Decimal?           @db.Decimal(12, 2)
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean            @default(true)
  usageLimit        Int?
  usageCount        Int                @default(0)
  perUserLimit      Int                @default(1)
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  redemptions       CouponRedemption[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([isActive, startsAt, expiresAt])
  @@index([userId])
}

model CouponRedemption {
  id              String                @id @default(cuid())
  couponId        String
  userId          String
  orderId         String                @unique
  discountAmount  Decimal               @db.Decimal(12, 2)
  status          CouponRedemptionStatus @default(RESERVED)
  redeemedAt      DateTime?
  releasedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  coupon          Coupon                @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId, status])
  @@index([userId, status])
}
